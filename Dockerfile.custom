# Use the official Node.js 20 image
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Remove any existing node_modules and package-lock.json to ensure a clean install
RUN rm -rf node_modules package-lock.json

# Install dependencies (excluding optional dependencies to avoid Rolldown)
RUN npm install --omit=optional

# Copy the rest of the files
COPY . .

# Force install latest Vite and build the project
RUN npm install --prefix client vite@latest && \
    npm run build -w client -- --force && \
    npm run build -w server

# Set production environment
ENV NODE_ENV=production

# Expose the port
EXPOSE 3001

# Start the server
CMD ["node", "server/dist/index.js"]